<% if object.errors.any? %>
  <div class="alert-danger">
    <p><strong><%= pluralize(object.errors.count, "error") %> prevented this from being saved:</strong></p>
    <ul>
      <% object.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
