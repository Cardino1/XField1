<section class="section" style="max-width: 900px; margin: 0 auto;">
  <div class="section-header">
    <h1 class="section-title">Share an Opportunity</h1>
    <p style="color: var(--muted);">Submissions go live once reviewed by the XField team.</p>
  </div>
  <div class="form-card">
    <%= form_with model: @opportunity, local: true do |form| %>
      <div>
        <%= form.label :opportunity_type, "Type" %>
        <%= form.select :opportunity_type, Opportunity.opportunity_types.keys.map { |type| [type.humanize, type] }, prompt: "Select a type" %>
        <%= form.object.errors.full_messages_for(:opportunity_type).join(", ") if form.object.errors[:opportunity_type].present? %>
      </div>
      <div>
        <%= form.label :title %>
        <%= form.text_field :title, placeholder: "Opportunity title" %>
      </div>
      <div>
        <%= form.label :full_name %>
        <%= form.text_field :full_name, placeholder: "Your full name" %>
      </div>
      <div>
        <%= form.label :organization, "Organization" %>
        <%= form.text_field :organization, placeholder: "University or Company" %>
      </div>
      <div>
        <%= form.label :description %>
        <%= form.text_area :description, placeholder: "Tell us what you're building or hiring for" %>
      </div>
      <div>
        <%= form.label :link, "Link (optional)" %>
        <%= form.url_field :link, placeholder: "https://" %>
      </div>
      <%= form.button "Submit for review" %>
    <% end %>
  </div>
</section>
