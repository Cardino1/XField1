<section class="mt-12">
  <div class="container">
    <%= link_to "← Back to opportunities", opportunities_path, class: "card-link" %>
    <div class="card mt-6">
      <div class="flex items-center space-x-3">
        <span class="badge"><%= @opportunity.category %></span>
        <p class="text-sm text-gray-600">Posted <%= formatted_datetime(@opportunity.created_at) %></p>
      </div>
      <h1 class="hero-title" style="font-size: 2.5rem;"><%= @opportunity.title %></h1>
      <p class="card-meta">Submitted by <%= @opportunity.full_name %>, <%= @opportunity.organization %></p>
      <div class="mt-4 leading-relaxed">
        <%= simple_format(@opportunity.description) %>
      </div>
      <% if @opportunity.link.present? %>
        <div class="mt-6">
          <%= link_to "Visit link", @opportunity.link, class: "btn-primary", target: "_blank", rel: "noopener" %>
        </div>
      <% end %>
    </div>
  </div>
</section>
