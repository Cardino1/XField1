<div class="section-header">
  <h1 class="section-title"><%= @article.title %></h1>
  <div class="table-actions">
    <%= link_to "Edit", edit_admin_article_path(@article) %>
    <%= button_to "Delete", admin_article_path(@article), method: :delete, data: { confirm: "Delete this article?" } %>
  </div>
</div>
<p style="color: var(--muted);">By <%= @article.author %> · <%= format_date(@article.published_at) %></p>
<div class="card" style="margin-top: 1.5rem; gap: 1rem;">
  <strong>Excerpt</strong>
  <p style="color: #e2e8f0;"><%= @article.excerpt %></p>
  <strong>Body</strong>
  <div style="white-space: pre-line; color: #cbd5f5;"><%= @article.body %></div>
</div>
