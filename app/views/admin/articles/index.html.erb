<div class="section-header">
  <h1 class="section-title">Articles</h1>
  <%= link_to "New article", new_admin_article_path, class: "nav-link" %>
</div>
<table class="table">
  <thead>
    <tr>
      <th>Title</th>
      <th>Author</th>
      <th>Published</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @articles.each do |article| %>
      <tr>
        <td><%= article.title %></td>
        <td><%= article.author %></td>
        <td><%= format_date(article.published_at) %></td>
        <td class="table-actions">
          <%= link_to "View", admin_article_path(article) %>
          <%= link_to "Edit", edit_admin_article_path(article) %>
          <%= button_to "Delete", admin_article_path(article), method: :delete, data: { confirm: "Delete this article?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
