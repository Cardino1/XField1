<h1 class="section-title">Overview</h1>
<div class="grid cards-4" style="margin-top: 2rem;">
  <div class="card">
    <span class="label">Articles</span>
    <h3><%= @articles_count %></h3>
    <p>Total published stories.</p>
  </div>
  <div class="card">
    <span class="label">Pending Opportunities</span>
    <h3><%= @pending_opportunities %></h3>
    <p>Awaiting review.</p>
  </div>
  <div class="card">
    <span class="label">Investors</span>
    <h3><%= @investors_count %></h3>
    <p>Partner firms in the directory.</p>
  </div>
  <div class="card">
    <span class="label">Subscribers</span>
    <h3><%= @subscriptions_count %></h3>
    <p>Newsletter signups.</p>
  </div>
</div>
