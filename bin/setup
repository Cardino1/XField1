#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
include FileUtils

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args) || abort("Command failed: #{args.join(' ')}")
end

chdir APP_ROOT do
  system!("bundle install")
  system!("bin/rails db:prepare")
end
